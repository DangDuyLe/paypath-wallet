# PayPath Wallet Environment Variables
# Copy this file to .env and fill in your values

# Backend API
VITE_API_URL=https://sui-payment.onrender.com/api

# Gaian Payment Gateway API
VITE_GAIAN_API_URL=https://payments.gaian.io
VITE_GAIAN_API_KEY=your_api_key_here 

# ========================================
# Multi-chain Configuration
# ========================================

# Enable/Disable chains (1 = enabled, 0 = disabled)
VITE_ENABLE_SUI=1
VITE_ENABLE_AVAX=1

# Avalanche Network Configuration
# Chain ID: 43113 (Fuji Testnet) or 43114 (Mainnet)
VITE_AVAX_CHAIN_ID=43113
VITE_AVAX_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Avalanche USDC Contract Address
# Fuji Testnet: 0x5425890298aed601595a70AB815c96711a31Bc65
# Mainnet: 0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E
VITE_AVAX_USDC_CONTRACT=0x5425890298aed601595a70AB815c96711a31Bc65

# WalletConnect (optional, for better wallet support)
VITE_WALLET_CONNECT_PROJECT_ID=
